{
  "_version": "1.76.0",
  "sap.app": {
    "id": "artechcapacitacionfiori",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.6",
      "toolsId": "ecb05a89-8606-4f41-b0cf-6ba215ed8898"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.143.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "artechcapacitacionfiori.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "artechcapacitacionfiori.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteApp",
          "pattern": ":?query:",
          "target": [
            "TargetApp"
          ]
        },
        {
          "name": "RouteHobbiesDetail",
          "pattern": "HobbiesDetail/",
          "target": ["TargetHobbiesDetail"]
        },
        {
          "name": "RouteJobDetail",
          "pattern": "JobDetail/{id}",
          "target": ["TargetJobDetail"]
        }
      ],
      "targets": {
        "TargetApp": {
          "id": "App",
          "name": "App"
        },
        "TargetHobbiesDetail": {
          "id": "HobbiesDetail",
          "name": "HobbiesDetail"
        },
        "TargetJobDetail": {
          "id": "JobDetail",
          "name": "JobDetail"
        }
      }
    },
    "rootView": {
      "viewName": "artechcapacitacionfiori.view.App",
      "type": "XML",
      "id": "AppRoot",
      "async": true
    }
  }
}
